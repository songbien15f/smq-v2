{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",

  // `NODE_ENV` changes what the build produces, so it invalidates the cache.
  "globalEnv": ["NODE_ENV"],

  // Run-time configuration is passed through but does **not** invalidate the cache: none of
  // these changes the artefact a task produces.
  //
  // Listed explicitly because Turbo filters the environment by default, and the failure is
  // silent and misleading: a variable omitted here reaches the task as *unset*, and the app then
  // fails with a message about a different setting — pointing at the wrong thing to fix.
  //
  // `TEST_DATABASE_URL` is here because `pnpm test` runs the suites through Turbo: without it the
  // destructive suites see no test database and refuse to start.
  "globalPassThroughEnv": [
    "DB_DRIVER",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "DEVICE_IDLE_DAYS",
    "TRUST_PROXY",
    "PDF_CONCURRENCY",
    "API_PORT",
    "API_HOST",
    "API_BASE_URL",
    "ADMIN_ORIGIN",
    "CLIENT_ORIGIN",
    "SITE_ORIGIN",
    "SESSION_SECRET",
    "SESSION_TTL_HOURS",
    "SESSION_IDLE_HOURS",
    "PRICE_BOOKS",
    "PDF_CACHE",
    "CHROME_PATH",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "MAIL_FROM",
    "ENQUIRY_TO",
    "GUEST_NOTIFY_TO",
    "GUEST_REQUEST_PREFIX",
    "GUEST_PLACES_ENABLED",
    "GUEST_PLACES_SESSION_SECRET",
    "GUEST_PLACES_DAILY_AUTOCOMPLETE_CAP",
    "GUEST_PLACES_DAILY_DETAILS_CAP",
    "GOOGLE_PLACES_API_KEY",
    "SHEDSAFE_BASE_URL",
    "SHEDSAFE_USERNAME",
    "SHEDSAFE_PASSWORD",
    "AI_BASE_URL",
    "AI_API_KEY",
    "AI_MODEL",
    "COMPANY_NAME",
    "COMPANY_SLUG",
    "COMPANY_ABN",
    "COMPANY_SEATS",
    "COMPANY_SUBSCRIPTION_ENDS",
    "COMPANY_ADMIN_EMAIL",
    "COMPANY_ADMIN_PASSWORD",
    "COMPANY_ADMIN_NAME",
    "PLATFORM_ADMIN_EMAIL",
    "PLATFORM_ADMIN_PASSWORD",
    "PLATFORM_ADMIN_NAME",
    "SEED_PLATFORM_EMAIL",
    "SEED_PLATFORM_PASSWORD",
    "SEED_COMPANY_SLUG",
    "SEED_COMPANY_EMAIL",
    "SEED_COMPANY_PASSWORD",
    "COMPANY_CODE",
    "COMPANY_ADMIN_USERNAME",
    "LOGO_FILE",
    "NEXT_PUBLIC_LOGO_SRC",
    "NEXT_PUBLIC_SQ_ASSISTANT",
    "NEXT_PUBLIC_BRAND_SITE_URL",
    // The Guest assistant (plan G-g). The key is a server secret: it must never be a NEXT_PUBLIC_ var.
    "VILAO_BASE_URL",
    "VILAO_API_KEY",
    "VILAO_MODEL",
    "VILAO_STT_MODEL",
    "GUEST_ASSISTANT_ENABLED",
    "GUEST_ASSISTANT_DAILY_TURNS",
    // Each front-end's listening port. `scripts/next-port.mjs` reads these (start/ports.env is the
    // one place to change them); without these lines Turbo would hand the tasks nothing and every
    // app would fall back to its default, quietly undoing the change.
    "CLIENT_PORT",
    "ADMIN_PORT",
    "SITE_PORT",
    // Where each service is reachable. Derived from the ports above when unset — see
    // `serviceOrigins` in apps/api/src/config.ts.
    "API_ORIGIN",
    "CLIENT_ORIGIN",
    "ADMIN_ORIGIN",
    "SITE_ORIGIN"
  ],

  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      // `^build` once before anything watches, so a freshly cloned checkout has the
      // packages' `dist` before an app imports them. The watchers must not clean `dist`
      // afterwards — see the `build` scripts in each package.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
