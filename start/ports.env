# ============================================================================
#  SmartQuote v2 — the port each service listens on.
#
#  This is the ONE place to change them. `start\start-306.bat` and
#  `start\stop-306.bat` read this file, work out the matching origins
#  (http://localhost:<port>) and hand them to every service, so a port changed
#  here cannot end up half-applied: the API's allow-list, the browser origins
#  and the four front-ends all move together.
#
#  Why a file of its own: 3060–3063 and 3065 are ordinary numbers and something
#  else on the machine may already hold one (another checkout, a container, a
#  stale process). Editing the numbers here is the whole fix.
#
#  Rules:
#    - One port per service, 1024–65535, all five different.
#    - Plain `KEY=VALUE` lines; no quotes, no `export`, no spaces around `=`.
#    - A value already in the shell wins over this file, so a one-off override works:
#        set CLIENT_PORT=3071   then   start\start-306.bat
#      (`set` only fills blanks, so a stray value left in a shell window is worth clearing.)
#
#  Running the services by hand (`pnpm dev`) without the launcher? Then this file is
#  not read. Set the same names in the shell instead, e.g.
#    set API_PORT=3070 & set CLIENT_PORT=3071 & set ADMIN_PORT=3072 & set SITE_PORT=3073
#  (PowerShell: $env:API_PORT=3070; ...; pnpm dev). The API derives its allowed origins
#  from those ports (apps/api/src/config.ts `serviceOrigins`); a front-end's bridge derives
#  the API URL from API_PORT (`resolveApiBaseUrl`).
# ============================================================================

API_PORT=3060
CLIENT_PORT=3061
ADMIN_PORT=3062
SITE_PORT=3063
# The marketing site in 00.smartcoaustralia.com.au — a separate npm project, so
# it is not part of `pnpm dev` and the launcher passes this port to `next dev`
# explicitly. Its own package.json also pins 3065; keep the two in step.
INTRO_PORT=3065
