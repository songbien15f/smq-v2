# ---------------------------------------------------------------------------
# Copy this file to .env and edit it. .env is git-ignored and never committed.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. For a local server use 127.0.0.1; inside
# docker-compose this is overridden to reach the `db` service hostname.
DATABASE_URI=postgresql://postgres:123456@127.0.0.1:5432/smartcoa

# Long random string used to sign sessions and tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be replaced before any public deployment.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public origin of the site. Drives canonical URLs, OpenGraph, sitemap, robots
# and JSON-LD. Use the real https URL in production (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3065

# First admin user, created by `npm run seed` while the users collection is
# empty. Change both before a public deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!

# Password for the docker-compose `db` service and for DATABASE_URI inside
# compose. Only used by Docker; ignored by local npm scripts. The 123456
# default matches DATABASE_URI above for local parity — replace it in production.
# POSTGRES_PASSWORD=123456

# Optional: PostgreSQL client bin directory, used by `npm run backup` when
# pg_dump is not on PATH (the Windows installer does not add it).
# PG_BIN=C:\Program Files\PostgreSQL\18\bin

# Email is optional. Leave MAIL_ENABLED=false until real credentials are available:
# inquiries are still stored in the admin inbox, only the notification is skipped.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart Solutions Australia <no-reply@smartsolutionsaustralia.com.au>"
MAIL_TO_QUOTE=info@smartsolutionsaustralia.com.au
MAIL_TO_CONTACT=info@smartsolutionsaustralia.com.au

# Where "Request a Quote" sends visitors: the SmartQuote web app's guest flow.
# Read per request, so the same build works in every environment. The site adds
# step=start and src=intro when they are missing.
QUOTE_APP_URL=http://localhost:3063/quote?step=start
