# Copy to apps/site/.env.local. Next reads this app's own env files only — the repo-root .env is not read here.
# Every NEXT_PUBLIC_ value is baked in at build time: rebuild the site after changing one.

# The API, for documents and share links the browser opens directly. Production: the API's public https origin.
NEXT_PUBLIC_API_BASE=http://localhost:3060/api/v1

# The company (intro) site, no trailing slash. The Guest page's logo links to its home page and the header
# shows Home / Projects / Contact links to it. Empty: the logo links to `/` and the header has no links.
# Production: the real https domain of the company site.
NEXT_PUBLIC_BRAND_SITE_URL=http://localhost:3065

# Guest assistant panel for every visitor (1 = on). `?assistant=1` on the address overrides it for one look.
NEXT_PUBLIC_SQ_ASSISTANT=0
