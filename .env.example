# ---------------------------------------------------------------- runtime
NODE_ENV=development

# Where the API listens. The three front-ends call it.
API_PORT=3060
API_BASE_URL=http://localhost:3060/api/v1

# Each front-end's port lives in its own `package.json` (`next dev --port …`) — these variables used
# to sit here and **nothing read them**, so changing one did nothing. A setting that does not work is
# worse than no setting: it is an afternoon spent on the wrong cause. Removed 2026-11-06.

# The origin a browser uses. CSRF and share links are built from it.
ADMIN_ORIGIN=http://localhost:3062
CLIENT_ORIGIN=http://localhost:3061
SITE_ORIGIN=http://localhost:3063

# ---------------------------------------------------------------- database
# Postgres is the target. SQLite is the offline fallback: for a developer box with no
# server, and for a single-machine install. The same migrations run on both.
DB_DRIVER=postgres
DATABASE_URL=postgres://smartquote:smartquote@localhost:5432/smartquote

# Only read when DB_DRIVER=sqlite
DB_FILE=./data/app.db

# Multi-company since 2026-11-03. Companies are identified by their `code` (printed on a quote)
# and every row is scoped by tenant_id. There is no single-company flag. See docs/DECISIONS.md A2.

# ------------------------------------------------------- first-run company
# Read by `pnpm install:company`, and defaulted by start/start-306.bat. COMPANY_CODE is what a
# person types at the sign-in screen, so it belongs in whatever the operator is told.
# COMPANY_NAME=Demo Sheds Pty Ltd
# COMPANY_CODE=DEMOSHEDS
# COMPANY_ADMIN_USERNAME=owner
# COMPANY_ADMIN_EMAIL=owner@demo-sheds.local
# COMPANY_ADMIN_PASSWORD=a-long-enough-password
# COMPANY_SLUG=demo-sheds
# Optional: the vendor account for the admin app (signs in by email, not by code).
# PLATFORM_ADMIN_EMAIL=ops@smartquote.local
# PLATFORM_ADMIN_PASSWORD=platform-password-change-me

# ---------------------------------------------------------------- security
# Signs session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-change-me
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24

# ---------------------------------------------------------------- price book
# Content-addressed immutable books. One file per publication, never edited in place.
PRICE_BOOKS=./data/price-books
# Where the licensed supplier dump is read from — `pnpm publish-book` takes `--dump` and defaults to
# `./tools/price-dump/out`. No environment variable was ever read for it; the one that used to be
# listed here was inert and has been removed (2026-11-06).
PDF_CACHE=./data/pdf-cache

# ---------------------------------------------------------------- branding
# The platform's own mark. `LOGO_FILE` is what the API reads from disk to embed in a quote; the
# `NEXT_PUBLIC_` twin is the same image served to the browser for the app header. Unset means
# documents print the company's text logo and the header shows the built-in shield.
# To change it, point these at a NEW file: a saved quote remembers the hash of the logo it was sent
# with, so overwriting the old file makes those documents print text instead.
LOGO_FILE=./assets/logo.png
NEXT_PUBLIC_LOGO_SRC=/logo.png

# ---------------------------------------------------------------- documents
# Absolute path to a Chromium/Chrome binary. Without it PDF answers 503 and HTML still works.
CHROME_PATH=

# ---------------------------------------------------------------- mail
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a domain verified with the relay, or the relay refuses at the last step.
MAIL_FROM=no_reply@example.com
# Where an enquiry from the public site is emailed. Comma-separate for several mailboxes.
#
# Every platform administrator also receives a copy, deduplicated against this list — the sales
# inbox answers the customer, the vendor staff keep the record. Leave it empty and only the
# administrators get one; the enquiry is stored in the admin queue either way, so a deployment with
# no mail configured still keeps every lead.
#
# The copy's Reply-To is the enquirer's own address, so "Reply" reaches the customer.
ENQUIRY_TO=

# ---------------------------------------------------------------- integrations
# Kept server-side only. Never a NEXT_PUBLIC_ variable.
GOOGLE_PLACES_API_KEY=
SHEDSAFE_BASE_URL=https://api.sitecheck.shedsafe.com.au/v1
SHEDSAFE_USERNAME=
SHEDSAFE_PASSWORD=

# ---------------------------------------------------------------- AI (optional)
# OpenAI-compatible gateway for plain-English shed descriptions.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
