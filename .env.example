# ---------------------------------------------------------------- runtime
NODE_ENV=development

# Where the API listens. The three front-ends call it.
API_PORT=3060
API_BASE_URL=http://localhost:3060/api/v1

# The three front-ends' ports are in `start/ports.env`, read by the launcher; `CLIENT_PORT`,
# `ADMIN_PORT` and `SITE_PORT` reach `scripts/next-port.mjs` when they are set in the shell instead.
#
# The origin a browser uses. Each **derives from its port** when left blank (see
# `serviceOrigins` in apps/api/src/config.ts), so a port changed in `start/ports.env` needs nothing
# here. State them explicitly only when a service is reachable on another host or scheme — a
# deployment behind a domain, say. CSRF checks and mail links are built from these.
# ADMIN_ORIGIN=https://admin.example.com
# CLIENT_ORIGIN=https://app.example.com
# SITE_ORIGIN=https://quotes.example.com

# ---------------------------------------------------------------- database
# Postgres, everywhere (DECISIONS D1). There is no SQLite branch for the application database;
# SQLite survives only as the price book's file format, which is not configured here.
DB_DRIVER=postgres
DATABASE_URL=postgres://smartquote:smartquote@localhost:5432/smartquote

# The destructive test suites (`@sq/api`, `@sq/db`) run against this. Both **drop every table**, so
# the database name must contain `test` — the suite refuses anything else. `@sq/api` uses the
# database as given; `@sq/db` uses its own schema inside it, because the two suites run in parallel.
TEST_DATABASE_URL=postgres://smartquote:smartquote@localhost:5432/smartquote_test

# Multi-company since 2026-11-03. Companies are identified by their `code` (printed on a quote)
# and every row is scoped by tenant_id. There is no single-company flag. See docs/DECISIONS.md A2.

# ------------------------------------------------------- first-run company
# Read by `pnpm install:company`, and defaulted by start/start-306.bat. COMPANY_CODE is what a
# person types at the sign-in screen, so it belongs in whatever the operator is told.
# COMPANY_NAME=Demo Sheds Pty Ltd
# COMPANY_CODE=DEMOSHEDS
# COMPANY_ADMIN_USERNAME=owner
# COMPANY_ADMIN_EMAIL=owner@demo-sheds.local
# COMPANY_ADMIN_PASSWORD=a-long-enough-password
# COMPANY_SLUG=demo-sheds
# Optional: the vendor account for the admin app (signs in by email, not by code).
# PLATFORM_ADMIN_EMAIL=ops@smartquote.local
# PLATFORM_ADMIN_PASSWORD=platform-password-change-me

# ---------------------------------------------------------------- security
# Signs session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-change-me
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24

# A seat belongs to a device, not a session. A device not used for this many days gives its seat
# back automatically (whole days, 1–365). Too small and somebody back from leave has lost their
# seat; too large and an abandoned laptop holds one for a month.
DEVICE_IDLE_DAYS=14

# Which peers may set X-Forwarded-For. `loopback` is one machine — the default, and what `pnpm dev`
# runs. Other useful values:
#   loopback,uniquelocal   Docker, where the bridge is on a private network
#   <Cloudflare ranges>    when the deployment sits behind Cloudflare
#   false                  no proxy at all: ignore the header entirely
# `true` is refused in production, because it means "trust the header from anyone".
TRUST_PROXY=loopback

# How many PDFs may be rendered at once. Each render is a Chromium instance at roughly 200–300 MB
# of RAM, so a 2 GB VPS wants 1 or 2. Concurrent renders wait in a queue rather than failing.
PDF_CONCURRENCY=2

# ------------------------------------------------------- vendor usage dashboard
# One password, and the only thing guarding /dashboard — a page that reads EVERY company's
# activity. It is not part of the product's sign-in and no company user can reach it.
#
# Set it in BOTH processes (api and client): the client holds it to check the submitted password and
# to sign the dashboard cookie, the API holds it to answer `/vendor/usage`. They must match, or the
# dashboard renders "could not read the figures".
#
# Leaving it unset **closes** the dashboard rather than opening it. Changing it signs out every
# existing dashboard session, because the cookie is signed with a key derived from the password.
VENDOR_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------- price book
# Content-addressed immutable books. One file per publication, never edited in place.
PRICE_BOOKS=./data/price-books
# Where the licensed supplier dump is read from — `pnpm publish-book` takes `--dump` and defaults to
# `./tools/price-dump/out`. No environment variable was ever read for it; the one that used to be
# listed here was inert and has been removed (2026-11-06).
PDF_CACHE=./data/pdf-cache

# ---------------------------------------------------------------- branding
# The platform's own mark. `LOGO_FILE` is what the API reads from disk to embed in a quote; the
# `NEXT_PUBLIC_` twin is the same image served to the browser for the app header. Unset means
# documents print the company's text logo and the header shows the built-in shield.
# To change it, point these at a NEW file: a saved quote remembers the hash of the logo it was sent
# with, so overwriting the old file makes those documents print text instead.
LOGO_FILE=./assets/logo.png
NEXT_PUBLIC_LOGO_SRC=/logo.png

# ---------------------------------------------------------------- editor
# 1 shows the Assistant frame in the quote editor (third column becomes the Assistant, the price moves to
# the strip and a "Price details" drawer). Not connected to any model yet. Unset keeps the three-column
# layout. `?assistant=1` / `?assistant=0` on the editor address overrides this for a quick look.
# NEXT_PUBLIC_SQ_ASSISTANT=1

# ---------------------------------------------------------------- guest quote page (apps/site /quote)
# The brand site's address (no trailing slash). The Guest page's logo links to its home page and the header
# shows Home / Projects / Contact links to it. Empty: the logo links to `/` and the header has no links.
# Set it in apps/site/.env.local (see apps/site/.env.example): Next does not read this root .env.
# Production: the company site's real https domain, then rebuild the site.

# ---------------------------------------------------------------- documents
# Absolute path to a Chromium/Chrome binary. Without it PDF answers 503 and HTML still works.
CHROME_PATH=

# ---------------------------------------------------------------- mail
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a domain verified with the relay, or the relay refuses at the last step.
MAIL_FROM=no_reply@example.com
# Where an enquiry from the public site is emailed. Comma-separate for several mailboxes.
#
# Every platform administrator also receives a copy, deduplicated against this list — the sales
# inbox answers the customer, the vendor staff keep the record. Leave it empty and only the
# administrators get one; the enquiry is stored in the admin queue either way, so a deployment with
# no mail configured still keeps every lead.
#
# The copy's Reply-To is the enquirer's own address, so "Reply" reaches the customer.
ENQUIRY_TO=

# The Guest quote page (apps/site /quote).
# Where a guest's request is emailed. Comma-separate for several mailboxes. Empty = the enquiry
# recipients above (ENQUIRY_TO plus every platform administrator). The guest always gets a copy.
GUEST_NOTIFY_TO=
# Prefix of a request number, e.g. GR-000123. Capitals, digits and dashes, at most 8; default GR-.
GUEST_REQUEST_PREFIX=GR-
# Address suggestions on the Guest page, from GOOGLE_PLACES_API_KEY below. On (1): guests search real
# addresses, which spends Google money from a public page (capped below). 0 turns it off and the page
# offers the price book's suburb list instead. Unset counts as off. The editor's own address
# suggestions are not affected.
GUEST_PLACES_ENABLED=1
# Signs the page's three-minute address sessions. Required (32+ characters) in production when
# GUEST_PLACES_ENABLED=1; unset in development, a random one is made at each start.
GUEST_PLACES_SESSION_SECRET=
# Most calls the whole system sends Google per UTC day; past either, the page falls back to the
# suburb list and one warning mail a day goes to GUEST_NOTIFY_TO (or the enquiry recipients).
GUEST_PLACES_DAILY_AUTOCOMPLETE_CAP=2000
GUEST_PLACES_DAILY_DETAILS_CAP=300

# ---------------------------------------------------------------- integrations
# Kept server-side only. Never a NEXT_PUBLIC_ variable.
GOOGLE_PLACES_API_KEY=
SHEDSAFE_BASE_URL=https://api.sitecheck.shedsafe.com.au/v1
SHEDSAFE_USERNAME=
SHEDSAFE_PASSWORD=

# ---------------------------------------------------------------- AI providers (optional)
# Google Gemini direct is the PRIMARY provider; the vilao gateway is the automatic FALLBACK. Both keys
# are server secrets: put them in `.env`, never here, never in the database, never with NEXT_PUBLIC_.
# `AI_PRIMARY` / `AI_FALLBACK` are only the defaults — a platform admin can change provider and models on
# the admin screen (/ai), which stores them in `ai_settings`. Keys are NOT stored there; rotating a key
# means editing `.env` and restarting the API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Defaults to GEMINI_MODEL when empty.
GEMINI_STT_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_THINKING_LEVEL=minimal
AI_PRIMARY=gemini
# gemini | vilao | none
AI_FALLBACK=vilao

# ---------------------------------------------------------------- Guest assistant (plan G-g)
# Off unless GUEST_ASSISTANT_ENABLED=1 AND at least one provider key is set. A missing key is not an
# error: the page shows "the assistant is unavailable" and the designer keeps working.
GUEST_ASSISTANT_ENABLED=0
# Whether the Guest page renders the assistant panel at all (build-time). 1 = show it.
NEXT_PUBLIC_SQ_ASSISTANT=0
GUEST_ASSISTANT_DAILY_TURNS=200
# Speech to text in the assistant's composer (plan 2026-11-22). Off even when the assistant is on,
# because a transcription is a second paid call per sentence. It needs a key, like the assistant does.
# The audio is never stored or logged; only the redacted transcript is returned.
GUEST_ASSISTANT_VOICE=0
# Platform-wide ceiling on transcriptions per day, across every visitor.
GUEST_ASSISTANT_DAILY_VOICE=100
VILAO_BASE_URL=https://api.vilao.ai/v1
VILAO_MODEL=wiki
VILAO_STT_MODEL=mgr/grok-stt
# The key is a **server secret**. Put it in `.env`, never here, and never with a NEXT_PUBLIC_ prefix.
VILAO_API_KEY=
